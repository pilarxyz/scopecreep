{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scopecreep.mjs\"",
            "timeout": 10,
            "statusMessage": "checking scope"
          }
        ]
      }
    ]
  }
}
